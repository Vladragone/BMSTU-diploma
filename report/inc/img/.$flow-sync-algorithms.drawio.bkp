  <diagram id="resend-flow" name="Повторная отправка">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Схема алгоритма повторной отправки неподтвержденных событий" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="170" y="30" width="960" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="Начало" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="has_pending" value="Событие находится&lt;br&gt;в pendingEvents?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="495" y="230" width="310" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="end_no_pending" value="Конец" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="890" y="270" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="wait_delay" value="Ожидать интервал&lt;br&gt;resendDelay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="470" y="440" width="360" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="still_pending" value="Событие все еще&lt;br&gt;находится в pendingEvents?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="495" y="580" width="310" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="end_ack" value="Конец" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="890" y="625" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="resend" value="Повторно отправить&lt;br&gt;тот же PuzzleEvent серверу" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=18;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="470" y="790" width="360" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ack_note" value="Получение Acknowledgement&lt;br&gt;удаляет событие из pendingEvents.&lt;br&gt;После этого цикл повторной&lt;br&gt;отправки завершается." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=16;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="80" y="575" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e_start_pending" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="start" target="has_pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pending_no" value="нет" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontSize=16" edge="1" parent="1" source="has_pending" target="end_no_pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pending_yes" value="да" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontSize=16" edge="1" parent="1" source="has_pending" target="wait_delay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_wait_still" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="wait_delay" target="still_pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_still_no" value="нет" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontSize=16" edge="1" parent="1" source="still_pending" target="end_ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_still_yes" value="да" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontSize=16" edge="1" parent="1" source="still_pending" target="resend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_resend_loop" value="ожидание следующего интервала" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontSize=16" edge="1" parent="1" source="resend" target="wait_delay">
          <mxGeometry relative="1" as="geometry">
