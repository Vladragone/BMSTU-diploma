        <mxCell id="e_transition_end" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="reject_transition" target="end_transition"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_transition_yes" value="да" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;fontSize=16" edge="1" parent="1" source="transition_ok" target="apply_fsm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_apply_store" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="apply_fsm" target="store_key"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_store_seq" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="store_key" target="increase_seq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_seq_ack" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="increase_seq" target="send_ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ack_broadcast" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;endFill=1;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="send_ack" target="broadcast"><mxGeometry relative="1" as="geometry"/></mxCell>
